rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Match any document in the users collection
    match /users/{userId} {
      // Allow the user to read and write their own main document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow the user to read and write all subcollections (e.g., problems, attempts)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
